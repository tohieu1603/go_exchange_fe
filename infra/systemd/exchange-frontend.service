# Micro-Exchange · Frontend (Next.js standalone bundle)
#
# Install:
#   sudo cp infra/systemd/exchange-frontend.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now exchange-frontend.service
#
# Edit the User= and WorkingDirectory= lines if your deploy paths differ
# from the defaults assumed by exchange-fe-deploy.sh.

[Unit]
Description=Micro-Exchange · Frontend (Next.js)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=oceanroot
WorkingDirectory=/srv/micro-exchange-fe/.next/standalone
EnvironmentFile=/etc/exchange/frontend.env
# next.config.ts emits server.js inside .next/standalone/
ExecStart=/usr/bin/node /srv/micro-exchange-fe/.next/standalone/server.js
Restart=always
RestartSec=3
# Crash-loop guard so a broken bundle doesn't hammer the journal.
StartLimitIntervalSec=60
StartLimitBurst=5
# Hardening — Next runtime doesn't need to write outside its work dir.
ProtectSystem=full
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
