# Micro-Exchange · Frontend (next start)
#
# Install:
#   sudo cp infra/systemd/exchange_fe.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now exchange_fe
#
# This unit runs `next start` (NOT the standalone bundle) so the deploy
# pipeline can stick to plain `npm install + npm run build + restart`.
# nginx handles TLS + vhost (exchange.operis.vn → 127.0.0.1:3000).

[Unit]
Description=Micro-Exchange · Frontend (Next.js)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=oceanroot
WorkingDirectory=/home/oceanroot/exchange_fe
EnvironmentFile=/etc/exchange/frontend.env
# `npm start` resolves to `next start` per package.json. Use absolute
# node binary so PATH issues under systemd don't break startup.
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=3
# Crash-loop guard so a broken build can't fill journald.
StartLimitIntervalSec=60
StartLimitBurst=5
# Hardening — Next runtime doesn't need to write outside its work dir.
ProtectSystem=full
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
