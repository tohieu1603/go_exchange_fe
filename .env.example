# ToHieuX FE — environment template
# Copy to `.env.local` (git-ignored) and edit for your local stack.

# Gateway HTTP base URL — every axios call (auth, market, trading, admin, …)
# is built relative to this. Must include the trailing `/api`.
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# WebSocket base URL — gateway exposes both /ws (legacy) and /api/ws.
# Prefer /api/ws so the FE works with a single base URL convention.
NEXT_PUBLIC_WS_URL=ws://localhost:8080/api/ws

# Google Sign-In — OAuth 2.0 Web Client ID from Google Cloud Console.
# Must match GOOGLE_CLIENT_ID set on auth-service. Authorized JavaScript
# origins must include this app's origin (e.g. http://localhost:3000,
# https://exchange.operis.vn).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
